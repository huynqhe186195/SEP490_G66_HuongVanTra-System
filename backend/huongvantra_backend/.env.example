# Sao chép file này thành .env và điền giá trị thực
# cp .env.example .env
#
# QUAN TRỌNG: các biến dưới đây KHÔNG còn giá trị mặc định trong docker-compose.yml.
# Thiếu bất kỳ biến nào, `docker compose up/build` sẽ dừng ngay kèm thông báo tên biến.
# Sinh giá trị mạnh (đừng đặt tay):
#   Linux/macOS : openssl rand -hex 32
#   Windows PS  : -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
# Đừng commit file .env, đừng dán giá trị thật vào task/commit message/chat.

# MySQL — bắt buộc
MYSQL_ROOT_PASSWORD=doi_thanh_mat_khau_manh
MYSQL_USER=hvtuser
MYSQL_PASSWORD=doi_thanh_mat_khau_manh

# RabbitMQ — RABBITMQ_PASS bắt buộc
RABBITMQ_USER=hvt
RABBITMQ_PASS=doi_thanh_mat_khau_manh

# JWT — bắt buộc, tối thiểu 32 ký tự (openssl rand -hex 32)
# Để trống ở đây có chủ đích: giá trị mẫu bị JwtSecretGuard từ chối, phải tự sinh.
JWT_SECRET=

# Internal API Key — bắt buộc, dùng cho header X-Internal-Api-Key giữa các service
# (Product/Order/Inventory phải cùng một giá trị). openssl rand -hex 32
INTERNAL_API_KEY=

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Cấu hình Email (Gmail SMTP) — gửi hóa đơn / nâng hạng cho khách
# 1) Bật Xác minh 2 bước trên tài khoản Gmail gửi đi
# 2) Tạo App Password: https://myaccount.google.com/apppasswords → chọn Mail / Windows
# 3) Dán 16 ký tự vào SMTP_PASS (không khoảng trắng). KHÔNG dùng mật khẩu đăng nhập Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email_cua_ban@gmail.com
SMTP_PASS=
# Để trống = gửi tới email thật của khách. Điền 1 email nếu muốn test toàn bộ về hộp đó.
DEMO_EMAIL_OVERRIDE=

# eSMS — quên mật khẩu OTP (https://esms.vn)
# 1) Đăng ký + nạp tiền + lấy ApiKey/SecretKey (Quản lý API)
# 2) Đăng ký Brandname (duyệt mới gửi được tin thật)
# 3) Sandbox=1 để test API không trừ tiền; =0 khi gửi thật
SMS_ENABLED=false
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SANDBOX=1
# Brandname mẫu Baotrixemay bắt buộc đúng template eSMS (đổi {otp}):
# ESMS_OTP_TEMPLATE={otp} la ma xac minh dang ky Baotrixemay cua ban
ESMS_OTP_TEMPLATE=HVT: Ma OTP dat lai mat khau la {otp}. Hieu luc {minutes} phut. Khong chia se ma nay.
# true = hiện OTP trên UI khi SMS chưa bật; khi SMS_ENABLED=true hệ thống tự ẩn OTP trên API
PASSWORD_RESET_EXPOSE_OTP=true

# Cloudinary (backend xóa ảnh khi từ chối/hủy yêu cầu tạo hàng hóa)
# Lấy tại Cloudinary Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=dpxbfgxqq
CLOUDINARY_API_KEY=api_key_cua_ban
CLOUDINARY_API_SECRET=api_secret_cua_ban

# Thanh toán chuyển khoản POS (Sepay) — KHÔNG bắt buộc
# Để trống = webhook trả 401, đơn chuyển khoản phải xác nhận tay (fail-closed, an toàn).
# Lấy secret trong Sepay Dashboard > Webhooks, phải khớp header Authorization: Apikey <secret>.
SEPAY_WEBHOOK_SECRET=
# Chỉ bật ở môi trường dev để giả lập webhook. TUYỆT ĐỐI để false ở production.
POS_ALLOW_SIMULATE_WEBHOOK=false
POS_SIMULATE_WEBHOOK_SECRET=

# ================================================================
# Frontend (web-client) — BẮT BUỘC khi chạy docker-compose.yml (bản production)
# ================================================================
# Vite nhúng các biến này vào bundle JS lúc `docker compose build`, KHÔNG đọc lại
# khi container chạy. Sửa xong phải build lại web-client mới có hiệu lực.
#
# frontend/huongvantra-web-client/.env bị .dockerignore loại khỏi build context,
# nên bản production KHÔNG lấy được giá trị từ đó. Nguồn duy nhất là file .env này.
# Chỉ overlay dev (docker-compose.dev.yml) mới đọc frontend/.../.env, vì nó chạy
# vite dev server trên source bind-mount thay vì build image.
#
# Bỏ trống VITE_API_BASE_URL => bundle mặc định http://localhost:5000, tức là
# trình duyệt của người dùng sẽ gọi về CHÍNH MÁY HỌ, không phải server.
# Trên VPS phải điền địa chỉ công khai của gateway.
VITE_API_BASE_URL=http://localhost:5000

# Upload ảnh hàng hóa (unsigned preset). Bỏ trống => FE báo "Chưa cấu hình Cloudinary".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# QR chuyển khoản ở POS. Bỏ trống => không sinh được mã QR.
VITE_VIETQR_BANK_BIN=
VITE_VIETQR_ACCOUNT_NUMBER=
VITE_VIETQR_ACCOUNT_NAME=
VITE_VIETQR_BANK_NAME=
