      "products-v1-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        }
      },
      "products-v1-list-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v1/products"
        }
      },
      "categories-v1-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },
      "categories-v1-list-route": {
