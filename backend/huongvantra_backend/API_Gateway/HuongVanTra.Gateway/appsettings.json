{
  "Jwt": {
    "Secret": "your-super-secret-key-at-least-32-characters-long",
    "Issuer": "HuongVanTra",
    "Audience": "HuongVanTra"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "customer-list-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers"
        }
      },
      "addresses-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/addresses/{**catch-all}"
        }
