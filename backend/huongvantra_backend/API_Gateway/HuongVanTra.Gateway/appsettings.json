        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customer-tiers/{**catch-all}"
        }
      },
      "customer-tiers-list-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customer-tiers"
        }
      },
      "integration-events-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/integration-events/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "roles-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "permissions-route": {
        "ClusterId": "user-cluster",
        "Match": {
