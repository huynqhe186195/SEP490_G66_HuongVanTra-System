<Project>
  <!-- Avoid Windows VS NuGet fallback paths breaking Linux docker bind mounts -->
  <PropertyGroup>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <!-- Exclude obj/ and bin/ from dotnet watch polling to prevent duplicate-key crash
       when Windows-built artifacts are visible inside the Linux container via bind mount. -->
  <ItemGroup>
    <Watch Remove="**/obj/**" />
    <Watch Remove="**/bin/**" />
  </ItemGroup>
</Project>
