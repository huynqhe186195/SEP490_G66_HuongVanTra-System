# API Gateway (Docker)
VITE_API_BASE_URL=http://localhost:5000

# VietQR cho thanh toán chuyển khoản tại POS (img.vietqr.io)
# BIN ngân hàng: MB=970422, Vietcombank=970436, BIDV=970418, Techcombank=970407, ...
VITE_VIETQR_BANK_BIN=970422
VITE_VIETQR_ACCOUNT_NUMBER=0123456789
VITE_VIETQR_ACCOUNT_NAME=HUONG VAN TRA
VITE_VIETQR_BANK_NAME=MB Bank

# Cloudinary (unsigned upload)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Local dev without Docker
# VITE_API_BASE_URL=http://localhost:5002
